# VGL POS environment template.
# Copy to .env and fill in values. NOTHING in this file is a real value.
# Lines commented out have safe built-in defaults; uncomment only to override.
# In production every secret below is REQUIRED and validated at boot.

# ── Application ──────────────────────────────────────────────────────────────
# One of: development | testing | production
APP_ENV=development

# Log level for the JSON log pipeline: DEBUG | INFO | WARNING | ERROR
#LOG_LEVEL=INFO

# Flask session/signing key. Production refuses missing, short (<32 chars) or
# known-default values. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
#SECRET_KEY=

# Signing key for JWTs. Same rules as SECRET_KEY; MUST be a different value.
#JWT_SECRET_KEY=

# Root key used to derive a distinct HMAC key for each offline terminal.
# Use another independent 48+ character value in production.
#OFFLINE_SYNC_SIGNING_SECRET=

# Bearer token accepted only by the internal Prometheus scrape endpoint.
# Production requires an independent 32+ character value.
#METRICS_AUTH_TOKEN=

# Optional privacy-scrubbed Sentry error reporting.
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=production
#SENTRY_TRACES_SAMPLE_RATE=0.0

# Safe deployment defaults; shared Redis overrides can be changed with the
# `flask feature-flag` command without a new release.
#FEATURE_EINVOICE_ENABLED=true
#FEATURE_EWAY_BILL_ENABLED=true
#FEATURE_REPORT_JOBS_ENABLED=true
# Public demo is disabled by default; the project Docker image enables its isolated demo tenant.
#DEMO_MODE_ENABLED=false

# Token lifetimes in seconds.
#JWT_ACCESS_TOKEN_EXPIRES=900
#JWT_REFRESH_TOKEN_EXPIRES=2592000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLAlchemy URL. Production requires PostgreSQL.
# Example: postgresql+psycopg://user:password@host:5432/dbname
# Unset in development = localhost default; inside docker compose the app
# container defaults to the postgres service below.
#DATABASE_URL=

# Used ONLY by the test suite (DATABASE_URL is ignored there on purpose).
# Leave unset for hermetic in-memory SQLite; if set, the database name MUST
# end in _test or the suite refuses to run.
#TEST_DATABASE_URL=

# Bootstrap credentials for the docker-compose postgres service.
# POSTGRES_PASSWORD is required by compose — pick a value before `docker compose up`.
POSTGRES_USER=vglpos
POSTGRES_PASSWORD=
POSTGRES_DB=vglpos

# ── Redis / Celery / cache / rate limiting ───────────────────────────────────
# Redis connection for cache, rate-limit storage and (by default) Celery.
#REDIS_URL=redis://localhost:6379/0

# Override the in-container Redis URL used by docker compose services.
#REDIS_URL_DOCKER=redis://redis:6379/0

# Point Celery at a different broker/result store than REDIS_URL if needed.
#CELERY_BROKER_URL=
#CELERY_RESULT_BACKEND=

# Durable generated report directory (must be on monitored persistent storage).
#REPORT_ARTIFACT_DIR=var/reports

# ── GST IRP / compliance ────────────────────────────────────────────────────
# NIC/GSP sandbox or production endpoints. Leave blank until e-invoicing is
# enabled for a company; provider credentials are never stored in the database.
#IRP_NIC_AUTH_URL=
#IRP_NIC_GENERATE_URL=
#IRP_NIC_LOOKUP_URL=
#IRP_NIC_CANCEL_URL=
#IRP_NIC_EWAY_URL=
#IRP_NIC_USERNAME=
#IRP_NIC_PASSWORD=
#IRP_NIC_CLIENT_ID=
#IRP_NIC_CLIENT_SECRET=
# Opt-in test only: unique schema-1.1 payload; generated IRN is cancelled by the test.
#RUN_NIC_SANDBOX_TESTS=0
#NIC_SANDBOX_EINVOICE_PAYLOAD=

# Optional operations webhook for dead letters, queue depth >50, or overdue IRNs.
#COMPLIANCE_ALERT_WEBHOOK_URL=
#COMPLIANCE_ALERT_API_TOKEN=

# WhatsApp receipt delivery. Leave all three empty to disable the endpoint.
#WHATSAPP_WEBHOOK_URL=https://provider.example/api/receipts
#WHATSAPP_API_TOKEN=
#PUBLIC_RECEIPT_BASE_URL=https://pos.example/receipts

# Flask-Limiter defaults.
#RATELIMIT_ENABLED=true
#RATELIMIT_DEFAULT=200 per minute
