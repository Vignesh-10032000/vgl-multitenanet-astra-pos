    {"id": 3, "type": "timeseries", "title": "Average bill", "targets": [{"expr": "sum(rate(checkout_revenue_rupees_total[15m])) / clamp_min(sum(rate(checkout_total[15m])), 1)"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}}
